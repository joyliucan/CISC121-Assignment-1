def solution(A):
  n = len(A)
  seen = [None] * (n + 1) # create array with the size of A filled with none

  for i in A:
    if i > n or i < 1: # <- THE PERM STARTS AT 1
      return 0
    if seen[i] == True: # check if the number has been seen
      return 0
    seen[i] = True # mark as seen
  return 1
print(solution([1, 5, 3, 2, 8, 7, 9, 4, 6, 10]))
